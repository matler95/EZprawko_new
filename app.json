{
  "expo": {
    "name": "EZprawko",
    "slug": "EZprawko_new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ezprawko-icon.png",
    "scheme": "ezprawkonew",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "fingerprint" },
    "ios": {
      "bundleIdentifier": "pl.ezprawko.app",
      "icon": {
        "light": "./assets/images/ezprawko-icon.png",
        "dark": "./assets/images/ezprawko-icon-dark.png"
      }
    },
    "android": {
      "package": "pl.ezprawko.app",
      "adaptiveIcon": {
        "backgroundColor": "#143D2C",
        "foregroundImage": "./assets/images/ezprawko-adaptive-icon.png",
        "monochromeImage": "./assets/images/ezprawko-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ezprawko-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F5",
          "image": "./assets/images/ezprawko-splash-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111613",
            "image": "./assets/images/ezprawko-splash-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-asset",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
