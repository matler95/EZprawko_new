EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MEDIA_BASE_URL=
EXPO_PUBLIC_MEDIA_MANIFEST_VERSION=local
# Local development diagnostics only; sanitized metadata, no external telemetry.
EXPO_PUBLIC_MEDIA_DIAGNOSTICS=0
# Configure these same public client variables in EAS development/preview/production.
# .env.local is excluded from cloud uploads. Never use a service-role/secret key here.
# Real EAS project UUID belongs in app.json -> expo.extra.eas.projectId (not a secret).
